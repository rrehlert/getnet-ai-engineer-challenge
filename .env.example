# Copy to .env and fill in. Defaults shown; only OPENAI_API_KEY is required.
LLM_MODEL=openai:openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional; web search falls back to DuckDuckGo when empty.
TAVILY_API_KEY=
JUDGE_ENABLED=true
# Defaults to LLM_MODEL when empty.
JUDGE_MODEL=
RELEVANCE_THRESHOLD=0.43
PORT=8000
# Persistent Chroma index directory (built at startup).
CHROMA_DIR=chroma

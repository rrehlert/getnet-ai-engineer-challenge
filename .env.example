# Copy to .env and fill in. Defaults shown; only OPENAI_API_KEY is required.
LLM_MODEL=openai:openai/gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional; web search falls back to DuckDuckGo when empty.
TAVILY_API_KEY=
JUDGE_ENABLED=true
# Use a different model family from LLM_MODEL (a warning is logged if they are equal).
JUDGE_MODEL=openai:anthropic/claude-haiku-5.5
RELEVANCE_THRESHOLD=0.5
PORT=8000
# All persistent state: the Corpus index (chroma/, built at startup) and the Conversations
# database (conversations.db).
STATE_DIR=state
# Key for the keyed hash (user_ref) that replaces the user id in logs. Empty: random key per
# process, with a warning (user_ref then changes on every restart).
LOG_HASH_KEY=
# HS256 key for login tokens. Empty: random secret per process, with a warning (tokens stop
# working on restart).
JWT_SECRET=
# Enables POST /dev/login ("log in as" any user id; demo only). Leave unset: compose defaults it
# to true; outside compose it is off. Setting it here applies to both.
# DEMO_LOGIN=false
# How the request and Judge log lines show the Message and reply: none (length only) | redacted | full (raw, capped).
LOG_MESSAGES=redacted
